# ============================================================
# HANGAR WORLD — CAMPEONATO FC26
# Variáveis de ambiente necessárias
#
# Copie este arquivo para ".env" (uso local) e/ou configure os mesmos
# nomes em Vercel → Project Settings → Environment Variables (produção).
# O ".env" nunca deve ser commitado — ele já está no .gitignore.
# ============================================================

# Painel do organizador (rota /adm) — senha única compartilhada.
# Escolha algo que só o organizador saiba, não precisa ser complexo.
ADMIN_PIN=2026

# Segredo usado para assinar o cookie de sessão do organizador.
# Gere um valor aleatório longo, por exemplo rodando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=troque-por-um-valor-aleatorio-bem-longo

# Supabase — Project Settings → API no painel do Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A SERVICE ROLE KEY é secreta — ela ignora as regras de segurança (RLS)
# e só deve existir aqui (variável de ambiente do servidor), NUNCA no
# código do navegador (por isso não fica em js/config.js).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
